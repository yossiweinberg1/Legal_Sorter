# Copy this file to `.env` and update values as needed.

# Optional (needed for crawl/fetch features)
COURTLISTENER_API_TOKEN=
# COURTLISTENER_API_TOKENS=token1,token2

# Optional (needed only for cloud LLM mode)
LLM_API_KEY=

# Optional auth / production overrides
LEGAL_SORTER_AUTH_ENABLED=false
# LEGAL_SORTER_API_KEYS=admin:change-me,operator:change-me,reader:change-me
# LEGAL_SORTER_PULL_FOLDER=/absolute/path/to/pull
# LEGAL_SORTER_INDEX_FOLDER=/absolute/path/to/index
# LEGAL_SORTER_PENDING_FOLDER=/absolute/path/to/pending
# LEGAL_SORTER_BACKUP_FOLDER=/absolute/path/to/backups
# LEGAL_SORTER_QUARANTINE_FOLDER=/absolute/path/to/quarantine
# LEGAL_SORTER_AUDIT_LOG_PATH=/absolute/path/to/logs/audit.log
# LEGAL_SORTER_SUPPORT_EMAIL=support@example.com
# LEGAL_SORTER_TELEMETRY_ENABLED=false

# Optional override
# COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
